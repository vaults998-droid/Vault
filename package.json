{
  "name": "vault",
  "private": true,
  "scripts": {
    "dev:web": "cd vault-web && npm run dev",
    "dev:bots": "cd vault-bots && node index.js",
    "build:web": "cd vault-web && npm run build",
    "install:all": "cd vault-bots && npm install && cd ../vault-web && npm install",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:bots\"",
    "start:all": "npm run install:all && npm run dev"
},
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}